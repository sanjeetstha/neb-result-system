# Backup destination (outside app repo is recommended)
BACKUP_ROOT=/srv/backups/neb-result-system

# Backup naming prefix
BACKUP_PREFIX=nebdb

# MySQL connection (fallbacks to .env DB_HOST/DB_USER/DB_PASSWORD/DB_NAME)
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_SOCKET=/var/lib/mysql/mysql.sock
# DB_USER=nebapp
# DB_PASSWORD=change-me
# DB_NAME=neb_results_dev

# Retention policy
RETENTION_DAYS=30
KEEP_LAST=120

# Verify gzip integrity after dump (1=enabled)
VERIFY_BACKUP=1

# gzip compression level (1-9)
COMPRESS_LEVEL=9

# Log path
BACKUP_LOG_FILE=/srv/backups/neb-result-system/backup.log
